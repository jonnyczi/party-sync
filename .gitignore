# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Native module gradle outputs (modules/*/android/ source is tracked, build artifacts are not)
**/android/build/
**/android/.gradle/
**/android/.cxx/

# Claude Code — keep settings.json shared, ignore per-machine local settings
.claude/settings.local.json

# Scratch dir for screenshots, payloads, ad-hoc test artifacts
tmp/

# IDE
.idea/
