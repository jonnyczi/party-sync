{
  "expo": {
    "name": "Party Sync",
    "slug": "copyparty-client",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "copypartyclient",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.jonnyczi.copypartyclient"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1f23",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "io.github.jonnyczi.copypartyclient",
      "versionCode": 9,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1b1f23",
          "dark": {
            "backgroundColor": "#1b1f23"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Party Sync needs access to your photos to back them up to your server.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withCleartextTraffic",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
