<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!-- Merged into the app manifest at build (android/ is regenerated by
         prebuild, so the service must be declared here, not there).
         dataSync: user-initiated upload of local files to the user's server. -->
    <service
      android:name="expo.modules.copypartysync.SyncForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <!-- SyncTaskWorker.setForeground runs under WorkManager's own service,
         which ships without a foregroundServiceType; API 34+ crashes with
         MissingForegroundServiceTypeException unless one is merged in. -->
    <service
      android:name="androidx.work.impl.foreground.SystemForegroundService"
      android:foregroundServiceType="dataSync"
      tools:node="merge" />
  </application>
</manifest>
